{
	"name": "@xernerx/terminal",
	"publishConfig": {
		"access": "public"
	},
	"version": "1.1.10",
	"type": "module",
	"description": "A cli log tool for xernerx projects",
	"main": "./dist/main.cjs",
	"module": "./dist/main.js",
	"types": "./dist/main.d.ts",
	"homepage": "www.xernerx.com",
	"files": [
		"src",
		"dist"
	],
	"exports": {
		"require": {
			"types": "./dist/main.d.cts",
			"default": "./dist/main.cjs"
		},
		"import": {
			"types": "./dist/main.d.ts",
			"default": "./dist/main.js"
		}
	},
	"scripts": {
		"commit": "prettier --write . && changeset",
		"ship": "pnpm run build && changeset version && git add . && git commit -m \"chore: release\" && changeset tag && git push --follow-tags",
		"docs": "typedoc",
		"build": "pnpm i && tsup && attw --pack && pnpm run docs",
		"dev": "concurrently \"tsup --watch\" \"node --watch test/main.mjs\"",
		"test": "pnpm install --engine-strict=true"
	},
	"keywords": [],
	"author": "Xernerx Studios",
	"license": "MIT",
	"packageManager": "pnpm@11.24.0",
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.2",
		"@changesets/cli": "^3.0.1",
		"@types/chalk-animation": "^1.6.3",
		"@types/node": "^24",
		"concurrently": "^10.0.5",
		"prettier": "^3.8.3",
		"tsc-watch": "^7.2.1",
		"tsup": "^8.5.1",
		"typedoc": "^0.28.20",
		"typedoc-github-theme": "^0.4.0",
		"typedoc-plugin-extras": "^4.0.1",
		"typedoc-plugin-zod": "^1.4.3",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"boxen": "^8.0.1",
		"chalk": "^5.6.2"
	},
	"engines": {
		"node": ">=24"
	}
}
